  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc -p .",
    "export:dids": "tsx scripts/export-dids.ts",
    "t3n:setup": "tsx scripts/t3n-setup.ts",
    "t3n:smoke": "tsx scripts/t3n-smoke.ts",
    "test:contract": "cd contracts/signguard-policy && cargo test",
    "build:contract": "cd contracts/signguard-policy && cargo build --release --target wasm32-wasip2",
    "t3n:measure": "tsx scripts/t3n-measure.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
