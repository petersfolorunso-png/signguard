// Host packages vendored from Terminal-3/agent-vault-starter (Apache-2.0),
// which vendors them from Terminal-3/trinity release testnet-v1.0.12:
// host:interfaces@2.4.0 and host:tenant@2.0.0. Re-vendor if testnet moves.
package z:signguard@0.1.0;

// tenant-base only: no HTTP import, so a user's rules can never leave the
// enclave through this contract.
world signguard {
  import host:tenant/tenant-context@2.0.0;
  import host:interfaces/logging@2.4.0;
  import host:interfaces/kv-store@2.4.0;

  export contracts;
}

interface contracts {
  record generic-input {
    input:        option<list<u8>>,
    user-profile: option<list<u8>>,
    context:      option<list<u8>>,
  }

  // The user saves their own rules. Refused on a delegated call.
  set-rules: func(req: generic-input) -> result<list<u8>, string>;
  // Verdict for tx facts against the calling user's rules: allow/warn/block + reason codes. Never returns the rules.
  check:     func(req: generic-input) -> result<list<u8>, string>;
  // The user deletes their rules. Refused on a delegated call.
  forget:    func(req: generic-input) -> result<list<u8>, string>;
}
