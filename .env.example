# Copy to ~/.secrets/terminal3/t3.env (chmod 600). NEVER commit real values.
# The server auto-loads that file; override the path with T3_ENV_FILE.

T3N_ENV=testnet
# From https://www.terminal3.io/claim-page (shown once).
T3N_API_KEY=
# Written by `npm run t3n:setup -- --org --register` (don't fill by hand):
T3N_ORG_DID=
T3N_CONTRACT=
# How users pay: "self" (default; org sponsors each new user DID) or "delegated" (agent pays)
# T3N_USER_MODE=self
# SIGNGUARD_USER_CREDITS=5          # sponsored to each new user DID
# SIGNGUARD_USER_CREDIT_CAP=25      # lifetime sponsorship per user
# SIGNGUARD_DAILY_CREDIT_BUDGET=1000
# Only for T3N_USER_MODE=delegated (written by --agent):
T3N_AGENT_DID=
T3N_AGENT_API_KEY=
# Generated by t3n:setup if empty:
SIGNGUARD_KEY_SECRET=
SIGNGUARD_ADMIN_TOKEN=

# Optional
# SIGNGUARD_MODE=mock        # force mock even when keys exist
# SIGNGUARD_PRICES=off       # disable the CoinGecko ETH/BNB/POL price lookup
# PORT=8787
